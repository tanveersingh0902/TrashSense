# ============================================================
# TRASHSENSE - Git Ignore File
# ============================================================
# This file tells Git which files/folders to IGNORE
# (not track or upload to GitHub).
# ============================================================

# --- Virtual Environment ---
# The venv folder is huge (hundreds of MB) and can be
# recreated with: pip install -r requirements.txt
venv/
env/
.venv/

# --- Python Cache ---
# Python creates these automatically. They are temporary files.
__pycache__/
*.py[cod]
*.pyo

# Trained Model Files
# Keep the trained model tracked; it is required for local inference.

# --- Dataset ---
# Image datasets are very large (100+ MB).
# Other users should download the dataset separately.
data/raw/


# --- OS Files ---
# System files that your OS creates automatically.
.DS_Store
Thumbs.db

# --- IDE Files ---
# Settings files created by code editors.
.vscode/
.idea/
*.swp

# --- Jupyter Notebook Checkpoints ---
.ipynb_checkpoints/

# --- Output files ---
# These can be regenerated by running the code.
outputs/
